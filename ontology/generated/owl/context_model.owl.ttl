@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
ctx:Application a owl:Class ;
	rdfs:label "Application" ;
	rdfs:subClassOf ctx:Entity , _:c14n1 , _:c14n11 , _:c14n112 , _:c14n12 , _:c14n13 , _:c14n132 , _:c14n139 , _:c14n14 , _:c14n140 , _:c14n141 , _:c14n143 , _:c14n144 , _:c14n146 , _:c14n15 , _:c14n18 , _:c14n22 , _:c14n34 , _:c14n38 , _:c14n39 , _:c14n43 , _:c14n5 , _:c14n50 , _:c14n52 , _:c14n53 , _:c14n60 , _:c14n64 , _:c14n69 , _:c14n71 , _:c14n83 , _:c14n84 , _:c14n88 , _:c14n95 , _:c14n97 ;
	skos:definition "A thing the business recognises as one system, however many parts it has." ;
	skos:inScheme ctx:entities ;
	ctx:ctx_id_pattern "{short_name}" .
ctx:Basis\#asserted a owl:Class ;
	rdfs:label "asserted" ;
	rdfs:subClassOf ctx:Basis ;
	skos:definition "straight from a source's own key, or confirmed by a person" .
ctx:Basis\#derived a owl:Class ;
	rdfs:label "derived" ;
	rdfs:subClassOf ctx:Basis ;
	skos:definition "follows from other relationships by a named rule" .
ctx:Basis\#inferred a owl:Class ;
	rdfs:label "inferred" ;
	rdfs:subClassOf ctx:Basis ;
	skos:definition "proposed by the resolver with a model's help; carries a confidence and reasons" .
ctx:Basis a owl:Class ;
	rdfs:label "Basis" ;
	owl:unionOf _:c14n120 ;
	skos:definition "How a relationship was established." ;
	skos:inScheme ctx:entities ;
	linkml:permissible_values ctx:Basis\#asserted , ctx:Basis\#derived , ctx:Basis\#inferred .
ctx:Capability a owl:Class ;
	rdfs:label "Capability" ;
	rdfs:subClassOf ctx:Entity , _:c14n137 , _:c14n58 , _:c14n68 , _:c14n73 , _:c14n76 , _:c14n87 ;
	skos:definition "A business capability from the enterprise architecture capability map." ;
	skos:inScheme ctx:entities ;
	ctx:ctx_id_pattern "{slug}" .
ctx:Decision a owl:Class ;
	rdfs:label "Decision" ;
	rdfs:subClassOf ctx:Entity , _:c14n10 , _:c14n118 , _:c14n124 , _:c14n133 , _:c14n136 , _:c14n23 , _:c14n29 , _:c14n30 , _:c14n31 , _:c14n4 , _:c14n63 , _:c14n65 , _:c14n92 , _:c14n99 ;
	skos:definition "An architecture decision record, with the entities it constrains." ;
	skos:inScheme ctx:entities ;
	ctx:ctx_id_pattern "{repo}/{number}" .
ctx:DecisionStatus\#accepted a owl:Class ;
	rdfs:label "accepted" ;
	rdfs:subClassOf ctx:DecisionStatus .
ctx:DecisionStatus\#proposed a owl:Class ;
	rdfs:label "proposed" ;
	rdfs:subClassOf ctx:DecisionStatus .
ctx:DecisionStatus\#superseded a owl:Class ;
	rdfs:label "superseded" ;
	rdfs:subClassOf ctx:DecisionStatus .
ctx:DecisionStatus a owl:Class ;
	rdfs:label "DecisionStatus" ;
	owl:unionOf _:c14n111 ;
	skos:inScheme ctx:entities ;
	linkml:permissible_values ctx:DecisionStatus\#accepted , ctx:DecisionStatus\#proposed , ctx:DecisionStatus\#superseded .
ctx:Endpoint a owl:Class ;
	rdfs:label "Endpoint" ;
	rdfs:subClassOf ctx:Entity , _:c14n114 , _:c14n131 , _:c14n135 , _:c14n142 , _:c14n147 , _:c14n24 , _:c14n57 , _:c14n70 , _:c14n77 , _:c14n80 , _:c14n86 ;
	skos:definition "A reachable host and path prefix." ;
	skos:inScheme ctx:entities ;
	ctx:ctx_id_pattern "{host}{path}" .
ctx:Entity a owl:Class ;
	rdfs:label "Entity" ;
	rdfs:subClassOf _:c14n119 , _:c14n129 , _:c14n130 , _:c14n145 , _:c14n20 , _:c14n3 , _:c14n49 , _:c14n55 , _:c14n61 , _:c14n62 , _:c14n7 , _:c14n75 , _:c14n79 ;
	skos:definition "Something the Context Model concluded exists, from one or more observations." ;
	skos:inScheme ctx:entities .
ctx:Exposure\#internal a owl:Class ;
	rdfs:label "internal" ;
	rdfs:subClassOf ctx:Exposure .
ctx:Exposure\#internet a owl:Class ;
	rdfs:label "internet" ;
	rdfs:subClassOf ctx:Exposure .
ctx:Exposure a owl:Class ;
	rdfs:label "Exposure" ;
	owl:unionOf _:c14n72 ;
	skos:inScheme ctx:entities ;
	linkml:permissible_values ctx:Exposure\#internal , ctx:Exposure\#internet .
ctx:Lifecycle\#planned a owl:Class ;
	rdfs:label "planned" ;
	rdfs:subClassOf ctx:Lifecycle .
ctx:Lifecycle\#production a owl:Class ;
	rdfs:label "production" ;
	rdfs:subClassOf ctx:Lifecycle .
ctx:Lifecycle\#retired a owl:Class ;
	rdfs:label "retired" ;
	rdfs:subClassOf ctx:Lifecycle .
ctx:Lifecycle\#retiring a owl:Class ;
	rdfs:label "retiring" ;
	rdfs:subClassOf ctx:Lifecycle .
ctx:Lifecycle a owl:Class ;
	rdfs:label "Lifecycle" ;
	owl:unionOf _:c14n51 ;
	skos:inScheme ctx:entities ;
	linkml:permissible_values ctx:Lifecycle\#planned , ctx:Lifecycle\#production , ctx:Lifecycle\#retired , ctx:Lifecycle\#retiring .
ctx:MarketUnit a owl:Class ;
	rdfs:label "MarketUnit" ;
	rdfs:subClassOf ctx:Entity ;
	skos:definition "An organisational unit of the group, usually a country or a region." ;
	skos:inScheme ctx:entities ;
	ctx:ctx_id_pattern "{slug}" .
ctx:Namespace a owl:Class ;
	rdfs:label "Namespace" ;
	rdfs:subClassOf ctx:Entity , _:c14n16 , _:c14n19 , _:c14n21 , _:c14n81 , _:c14n89 , _:c14n96 ;
	skos:definition "A namespace on a container cluster." ;
	skos:inScheme ctx:entities ;
	ctx:ctx_id_pattern "{name}" .
ctx:Repository a owl:Class ;
	rdfs:label "Repository" ;
	rdfs:subClassOf ctx:Entity , _:c14n101 , _:c14n102 , _:c14n104 , _:c14n121 , _:c14n122 , _:c14n134 , _:c14n17 , _:c14n2 , _:c14n32 , _:c14n41 , _:c14n42 , _:c14n44 , _:c14n45 , _:c14n47 , _:c14n66 , _:c14n67 , _:c14n74 , _:c14n82 ;
	skos:definition "A code repository on the git host." ;
	skos:inScheme ctx:entities ;
	ctx:ctx_id_pattern "{org}/{name}" .
ctx:Standing\#primary a owl:Class ;
	rdfs:label "primary" ;
	rdfs:subClassOf ctx:Standing ;
	skos:definition "the Context Model is authoritative" .
ctx:Standing\#secondary a owl:Class ;
	rdfs:label "secondary" ;
	rdfs:subClassOf ctx:Standing ;
	skos:definition "mirrored from an authoritative system; the source wins" .
ctx:Standing a owl:Class ;
	rdfs:label "Standing" ;
	owl:unionOf _:c14n46 ;
	skos:definition "Who is authoritative for a fact. Set per data set; an entity takes the standing of its data sets." ;
	skos:inScheme ctx:entities ;
	linkml:permissible_values ctx:Standing\#primary , ctx:Standing\#secondary .
ctx:Team a owl:Class ;
	rdfs:label "Team" ;
	rdfs:subClassOf ctx:Entity , _:c14n123 , _:c14n59 , _:c14n8 ;
	skos:definition "An accountable team." ;
	skos:inScheme ctx:entities ;
	ctx:ctx_id_pattern "{slug}" .
ctx:WafMode\#enforced a owl:Class ;
	rdfs:label "enforced" ;
	rdfs:subClassOf ctx:WafMode .
ctx:WafMode\#monitor a owl:Class ;
	rdfs:label "monitor" ;
	rdfs:subClassOf ctx:WafMode .
ctx:WafMode\#none a owl:Class ;
	rdfs:label "none" ;
	rdfs:subClassOf ctx:WafMode .
ctx:WafMode a owl:Class ;
	rdfs:label "WafMode" ;
	owl:unionOf _:c14n6 ;
	skos:inScheme ctx:entities ;
	linkml:permissible_values ctx:WafMode\#enforced , ctx:WafMode\#monitor , ctx:WafMode\#none .
ctx:Workload a owl:Class ;
	rdfs:label "Workload" ;
	rdfs:subClassOf ctx:Entity , _:c14n103 , _:c14n107 , _:c14n109 , _:c14n110 , _:c14n113 , _:c14n117 , _:c14n125 , _:c14n126 , _:c14n128 , _:c14n27 , _:c14n36 , _:c14n40 , _:c14n48 , _:c14n54 , _:c14n56 , _:c14n91 , _:c14n94 , _:c14n98 ;
	skos:definition "A deployed unit on a cluster, such as a deployment, a stateful set or a cron job." ;
	skos:inScheme ctx:entities ;
	ctx:ctx_id_pattern "{namespace}/{name}" .
ctx:archived a owl:DatatypeProperty ;
	rdfs:label "archived" ;
	skos:definition "The git host marks the repository read-only." ;
	skos:inScheme ctx:entities .
ctx:built_from a owl:ObjectProperty ;
	rdfs:domain ctx:Workload ;
	rdfs:label "built_from" ;
	rdfs:range ctx:Repository ;
	skos:definition "The workload's image is built from this repository." ;
	skos:inScheme ctx:relations ;
	ctx:ctx_cardinality "one" ;
	ctx:ctx_domain "Workload" ;
	ctx:ctx_range "Repository" .
ctx:cluster a owl:DatatypeProperty ;
	rdfs:label "cluster" ;
	skos:inScheme ctx:entities .
ctx:committers_12m a owl:DatatypeProperty ;
	rdfs:label "committers_12m" ;
	skos:definition "Distinct committers in the last twelve months." ;
	skos:inScheme ctx:entities .
ctx:constrains a owl:ObjectProperty ;
	rdfs:domain ctx:Decision ;
	rdfs:label "constrains" ;
	rdfs:range ctx:Entity ;
	skos:definition "The decision applies to this entity." ;
	skos:inScheme ctx:relations ;
	ctx:ctx_cardinality "many" ;
	ctx:ctx_domain "Decision" ;
	ctx:ctx_range "Entity" .
ctx:context-model.owl.ttl dcterms:license "Apache-2.0 OR MIT" ;
	dcterms:title "The Context Model" ;
	pav:version "0.1.0" ;
	a owl:Ontology ;
	rdfs:label "context_model" ;
	skos:definition "Entities concluded from what the sources of an IT landscape say, and the relationships between them. Every relationship is stored as a row with a basis, a confidence and a source." .
ctx:decided_on a owl:DatatypeProperty ;
	rdfs:label "decided_on" ;
	skos:inScheme ctx:entities .
ctx:depends_on a owl:ObjectProperty ;
	rdfs:domain ctx:Application ;
	rdfs:label "depends_on" ;
	rdfs:range ctx:Application ;
	skos:definition "The application calls, or needs, this other application." ;
	skos:inScheme ctx:relations ;
	ctx:ctx_cardinality "many" ;
	ctx:ctx_domain "Application" ;
	ctx:ctx_range "Application" .
ctx:deployed_as a owl:ObjectProperty ;
	rdfs:domain ctx:Application ;
	rdfs:label "deployed_as" ;
	rdfs:range ctx:Workload ;
	skos:definition "The application runs as this workload." ;
	skos:inScheme ctx:relations ;
	ctx:ctx_cardinality "many" ;
	ctx:ctx_domain "Application" ;
	ctx:ctx_range "Workload" .
ctx:description a owl:DatatypeProperty .
ctx:ea_id a owl:DatatypeProperty ;
	rdfs:label "ea_id" ;
	skos:definition "The application id in the EA repository, when it has one." ;
	skos:inScheme ctx:entities .
ctx:exposed_via a owl:ObjectProperty ;
	rdfs:domain ctx:Application ;
	rdfs:label "exposed_via" ;
	rdfs:range ctx:Endpoint ;
	skos:definition "The application is reachable through this endpoint." ;
	skos:inScheme ctx:relations ;
	ctx:ctx_cardinality "many" ;
	ctx:ctx_domain "Application" ;
	ctx:ctx_range "Endpoint" .
ctx:exposure a owl:ObjectProperty ;
	rdfs:label "exposure" ;
	skos:inScheme ctx:entities .
ctx:id a owl:DatatypeProperty ;
	rdfs:label "id" ;
	skos:definition "The Context Model id, for example ctx:Application/policy-admin." ;
	skos:inScheme ctx:entities .
ctx:image a owl:DatatypeProperty ;
	rdfs:label "image" ;
	skos:inScheme ctx:entities .
ctx:incidents_90d a owl:DatatypeProperty ;
	rdfs:label "incidents_90d" ;
	skos:definition "Incidents in the last 90 days, from IT service management." ;
	skos:inScheme ctx:entities .
ctx:last_commit a owl:DatatypeProperty ;
	rdfs:label "last_commit" ;
	skos:inScheme ctx:entities .
ctx:last_seen a owl:DatatypeProperty ;
	rdfs:label "last_seen" ;
	rdfs:range xsd:dateTime ;
	skos:inScheme ctx:entities .
ctx:level a owl:DatatypeProperty ;
	rdfs:label "level" ;
	skos:inScheme ctx:entities .
ctx:lifecycle a owl:ObjectProperty ;
	rdfs:label "lifecycle" ;
	skos:inScheme ctx:entities .
ctx:name a owl:DatatypeProperty ;
	rdfs:label "name" ;
	skos:inScheme ctx:entities .
ctx:not_in_ea a owl:DatatypeProperty ;
	rdfs:label "not_in_ea" ;
	skos:definition "True when no EA repository record backs the application." ;
	skos:inScheme ctx:entities .
ctx:operated_by a owl:ObjectProperty ;
	rdfs:domain ctx:Application ;
	rdfs:label "operated_by" ;
	rdfs:range ctx:MarketUnit ;
	skos:definition "The application is operated by, and serves, this market unit." ;
	skos:inScheme ctx:relations ;
	ctx:ctx_cardinality "many" ;
	ctx:ctx_domain "Application" ;
	ctx:ctx_range "MarketUnit" .
ctx:owned_by a owl:ObjectProperty ;
	rdfs:label "owned_by" ;
	rdfs:range ctx:Team ;
	skos:definition "The accountable team." ;
	skos:inScheme ctx:relations ;
	ctx:ctx_cardinality "one" ;
	ctx:ctx_domain "Application Repository Workload Namespace Endpoint" ;
	ctx:ctx_range "Team" .
ctx:part_of a owl:ObjectProperty ;
	rdfs:domain ctx:Team ;
	rdfs:label "part_of" ;
	rdfs:range ctx:MarketUnit ;
	skos:definition "The team belongs to this market unit." ;
	skos:inScheme ctx:relations ;
	ctx:ctx_cardinality "one" ;
	ctx:ctx_domain "Team" ;
	ctx:ctx_range "MarketUnit" .
ctx:realised_by a owl:ObjectProperty ;
	rdfs:domain ctx:Application ;
	rdfs:label "realised_by" ;
	rdfs:range ctx:Repository ;
	skos:definition "The application is implemented in this repository." ;
	skos:inScheme ctx:relations ;
	ctx:ctx_cardinality "many" ;
	ctx:ctx_domain "Application" ;
	ctx:ctx_range "Repository" .
ctx:refines a owl:ObjectProperty ;
	rdfs:domain ctx:Capability ;
	rdfs:label "refines" ;
	rdfs:range ctx:Capability ;
	skos:definition "The capability is a part of this broader capability." ;
	skos:inScheme ctx:relations ;
	ctx:ctx_cardinality "one" ;
	ctx:ctx_domain "Capability" ;
	ctx:ctx_range "Capability" .
ctx:replaced_by a owl:ObjectProperty ;
	rdfs:domain ctx:Application ;
	rdfs:label "replaced_by" ;
	rdfs:range ctx:Application ;
	skos:definition "The application is, or will be, replaced by this successor." ;
	skos:inScheme ctx:relations ;
	ctx:ctx_cardinality "one" ;
	ctx:ctx_domain "Application" ;
	ctx:ctx_range "Application" .
ctx:replicas a owl:DatatypeProperty ;
	rdfs:label "replicas" ;
	skos:inScheme ctx:entities .
ctx:routes_to a owl:ObjectProperty ;
	rdfs:domain ctx:Endpoint ;
	rdfs:label "routes_to" ;
	rdfs:range ctx:Workload ;
	skos:definition "The endpoint sends traffic to this workload." ;
	skos:inScheme ctx:relations ;
	ctx:ctx_cardinality "many" ;
	ctx:ctx_domain "Endpoint" ;
	ctx:ctx_range "Workload" .
ctx:runs_in a owl:ObjectProperty ;
	rdfs:domain ctx:Workload ;
	rdfs:label "runs_in" ;
	rdfs:range ctx:Namespace ;
	skos:definition "The workload runs in this namespace." ;
	skos:inScheme ctx:relations ;
	ctx:ctx_cardinality "one" ;
	ctx:ctx_domain "Workload" ;
	ctx:ctx_range "Namespace" .
ctx:standing a owl:ObjectProperty ;
	rdfs:label "standing" ;
	rdfs:range ctx:Standing ;
	skos:inScheme ctx:entities .
ctx:status a owl:ObjectProperty ;
	rdfs:label "status" ;
	skos:inScheme ctx:entities .
ctx:supersedes a owl:ObjectProperty ;
	rdfs:domain ctx:Decision ;
	rdfs:label "supersedes" ;
	rdfs:range ctx:Decision ;
	skos:definition "The decision replaces this earlier decision." ;
	skos:inScheme ctx:relations ;
	ctx:ctx_cardinality "one" ;
	ctx:ctx_domain "Decision" ;
	ctx:ctx_range "Decision" .
ctx:supports a owl:ObjectProperty ;
	rdfs:domain ctx:Application ;
	rdfs:label "supports" ;
	rdfs:range ctx:Capability ;
	skos:definition "The application supports this business capability." ;
	skos:inScheme ctx:relations ;
	ctx:ctx_cardinality "many" ;
	ctx:ctx_domain "Application" ;
	ctx:ctx_range "Capability" .
ctx:truck_factor a owl:DatatypeProperty ;
	rdfs:label "truck_factor" ;
	skos:definition "People who would have to leave before the repository stalls." ;
	skos:inScheme ctx:entities .
ctx:url a owl:DatatypeProperty ;
	rdfs:label "url" ;
	skos:inScheme ctx:entities .
ctx:waf a owl:ObjectProperty ;
	rdfs:label "waf" ;
	skos:inScheme ctx:entities .
ctx:workload_type a owl:DatatypeProperty ;
	rdfs:label "workload_type" ;
	skos:inScheme ctx:entities .
